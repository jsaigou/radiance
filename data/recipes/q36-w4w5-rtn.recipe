# q36-w4w5-rtn.recipe -- Qwen3.6-35B-A3B from the official bf16 checkpoint, as a smaller
# test candidate than the served FP8 container:
#
#   * the dense trunk exactly as the FP8 container holds it (block FP8, bf16 scale per 128x128),
#   * the routed experts at the nearest fast codebook formats to the Unsloth UD map
#     (UD Q4_K gate/up -> w4nl64a8h; UD Q5_K/Q6_K down -> w5nl64a8h),
#   * the MTP draft head derived from output.weight, as the FP8 container does.
#
# RTN (round to nearest, a searched scale), no calibration: this is the cheap first candidate. Its
# expert error is slightly above Unsloth's own; the GPTQ variant (q36-w4w5-gptq.recipe) is the
# calibrated one. Everything not named here is served as the bf16 checkpoint holds it, which is
# what the FP8 container holds too (token_embd, norms, router, ssm_a_log/alpha/beta/conv1d/dt,
# mtp.fc, nextn).
#
# The source is a bf16 release with no quantization_config, so tell rad-convert which release's
# descriptor this conversion targets; the plugin pair is selected by it (see tools/rad_convert.cpp,
# "The quantisation descriptor ... is derived from quantization_config"):
#
#   rad-convert <Qwen3.6-35B-A3B bf16 dir> \
#       --set quantization_config.quant_method=fp8 \
#       --recipe data/recipes/q36-w4w5-rtn.recipe -o q36-w4w5-rtn.rad
#
# Plan-only on 2026-11-13: 20.92 GiB would be written (the UD GGUF is 21.65 GiB, the FP8 .rad
# 34.6 GiB). Repo: jsaigou/radiance (PUBLIC, unofficial fork), local branch q36-w4w5-pilot.

# experts first (the first rule that matches a weight decides it)
blk.*.ffn_gate_up_exps.*.weight   rtn table=w4nl group=64 scale=fp8_e4m3 scale2=f32 block2=*x* scale2_value=0.0001220703125 transform=fwht128 rule=search
blk.*.ffn_down_exps.*.weight      rtn table=w5nl group=64 scale=fp8_e4m3 scale2=f32 block2=*x* scale2_value=0.0001220703125 transform=fwht128 rule=search

# dense trunk: the served container's encodings
blk.*.ssm_inz.weight              rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ssm_out.weight              rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_qg.weight              rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_k.weight               rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_v.weight               rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.attn_output.weight          rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ffn_gate_up_shexp.weight    rtn codes=fp8_e4m3 block=128x128 scale=bf16
blk.*.ffn_down_shexp.weight       rtn codes=fp8_e4m3 block=128x128 scale=bf16
output.weight                     rtn codes=fp8_e4m3 block=128x128 scale=bf16

# MTP draft head, derived from the (quantised) output.weight
mtp.draft_head.weight             rtn codes=u2 group=128 scale=f16 zero=u8
